<?xml version="1.0"?>
<robot name="my_robot">

  <!-- ========================================================= -->
  <!-- CHASSIS                                                   -->
  <!-- ========================================================= -->
  <link name="chassis">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.0"/>
      <!-- Caixa: 0.4 x 0.2 x 0.1 m -->
      <inertia
        ixx="0.0034167"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0134167"
        iyz="0.0"
        izz="0.0166667"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================= -->
  <!-- LEFT WHEEL                                                -->
  <!-- ========================================================= -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <!-- Cilindro: raio 0.1 m, comprimento 0.05 m -->
      <!-- Eixo do cilindro originalmente em Y -->
      <inertia
        ixx="0.0002917"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0005"
        iyz="0.0"
        izz="0.0002917"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================= -->
  <!-- RIGHT WHEEL                                               -->
  <!-- ========================================================= -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <!-- Cilindro: raio 0.1 m, comprimento 0.05 m -->
      <!-- Eixo do cilindro originalmente em Y -->
      <inertia
        ixx="0.0002917"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0005"
        iyz="0.0"
        izz="0.0002917"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================= -->
  <!-- CASTER                                                    -->
  <!-- ========================================================= -->
  <link name="caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <!-- Esfera de raio 0.05 m -->
      <inertia
        ixx="0.00005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00005"
        iyz="0.0"
        izz="0.00005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================= -->
  <!-- LEFT WHEEL JOINT                                          -->
  <!-- ========================================================= -->
  <joint name="left_wheel_hinge" type="continuous">
    <parent link="chassis"/>
    <child link="left_wheel"/>
    <origin xyz="0.1 0.13 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ========================================================= -->
  <!-- RIGHT WHEEL JOINT                                         -->
  <!-- ========================================================= -->
  <joint name="right_wheel_hinge" type="continuous">
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <origin xyz="0.1 -0.13 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ========================================================= -->
  <!-- CASTER JOINT                                              -->
  <!-- ========================================================= -->
  <joint name="caster_joint" type="fixed">
    <parent link="chassis"/>
    <child link="caster"/>
    <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- ROS 2 CONTROL                                             -->
  <!-- ========================================================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_hinge">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_hinge">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ========================================================= -->
  <!-- GAZEBO ROS 2 CONTROL                                      -->
  <!-- ========================================================= -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find pratica_2)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ========================================================= -->
  <!-- WHEEL FRICTION                                            -->
  <!-- ========================================================= -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- ========================================================= -->
  <!-- CASTER FRICTION                                           -->
  <!-- ========================================================= -->
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

</robot>

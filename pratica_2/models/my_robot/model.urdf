<?xml version="1.0"?>
<robot name="my_robot">

  <!-- 
    MUDANÇA: Substituição de <model name="..."> por <robot name="...">.
    PORQUÊ: O formato URDF (Unified Robot Description Format) exige a tag raiz <robot> 
    para definir a árvore cinemática do robô, ao contrário do SDF que usa <model>.
  -->

  <!-- ==================== CHASSIS LINK ==================== -->
  <link name="chassis">
    
    <!-- 
      MUDANÇA: Adição manual da tag <inertial> com <mass> e <inertia>.
      PORQUÊ: No SDF, se você omitir a inércia, o simulador (como o Gazebo clássico) 
      às vezes tenta estimar, mas no ecossistema ROS/URDF, cada link EXIGE propriedades 
      de inércia válidas.
    -->
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

    <!-- 
      MUDANÇA: Mudança de <pose> para <origin xyz="..." rpy="..."> dentro dos elementos de geometria.
      PORQUÊ: O URDF padroniza que deslocamentos de posição (xyz) e orientação (rpy - Roll, Pitch, Yaw) 
      sejam feitos através da tag <origin>.
    -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://pioneer2dx/meshes/chassis.dae" scale="0.9 0.5 0.5"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>

    <!-- 
      A roda boba (caster) permanece dentro do link "chassis".

      IMPORTANTE:
      O centro da caster está em Z = -0.05 e seu raio é 0.05.

      Portanto:

      -0.05 - 0.05 = -0.10

      Esse é o ponto mais baixo da caster.

      Para manter o robô alinhado, as rodas também terão seu ponto mais baixo em Z = -0.10.
    -->
    <collision name="caster_collision">
      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>

    <visual name="caster_visual">
      <origin xyz="-0.15 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>

  </link>


  <!-- ==================== LEFT WHEEL LINK ==================== -->
  <link name="left_wheel">

    <!-- 
      MUDANÇA: Adicionada a tag <inertial> obrigatória também para a roda esquerda.
    -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>

    <!-- 
      MUDANÇA: A rotação da roda agora é realizada dentro de <visual> e <collision>.

      PORQUÊ: O cilindro no URDF é criado inicialmente com seu eixo longitudinal apontando
      para o eixo Z.

      Como queremos que a roda gire em torno do eixo Y, rotacionamos o cilindro
      90 graus em torno do eixo X.

      1.5708 rad ≈ 90 graus.
    -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== RIGHT WHEEL LINK ==================== -->
  <link name="right_wheel">

    <!-- 
      MUDANÇA: Adicionada a tag <inertial> obrigatória para a roda direita.
    -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>

    <!-- 
      A mesma rotação utilizada na roda esquerda é aplicada aqui.

      Isso garante que as duas rodas fiquem paralelas e alinhadas.
    -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== JOINTS (ARTICULAÇÕES) ==================== -->
  
  <joint name="left_wheel_hinge" type="continuous">

    <!-- 
      O tipo continuous permite que a roda gire indefinidamente,
      sem limites mínimos ou máximos de rotação.
    -->

    <parent link="chassis"/>
    <child link="left_wheel"/>

    <!-- 
      MUDANÇA IMPORTANTE:

      ANTES:

      xyz="0.1 0.13 0.1"
      rpy="0 1.5707 1.5707"

      AGORA:

      xyz="0.1 0.13 0"
      rpy="0 0 0"

      PORQUÊ:

      A roda possui raio de 0.1.

      Se o centro da roda estiver em Z = 0:

      0 - 0.1 = -0.1

      Portanto, o ponto mais baixo da roda fica em Z = -0.10.

      Esse valor é exatamente igual ao ponto mais baixo da caster:

      -0.05 - 0.05 = -0.10

      Assim, roda esquerda, roda direita e caster ficam apoiadas
      no mesmo plano, deixando o robô alinhado.
    -->
    <origin xyz="0.1 0.13 0" rpy="0 0 0"/>

    <!-- 
      O eixo de rotação continua sendo o eixo Y.

      Como não estamos mais rotacionando o frame da joint,
      o eixo Y permanece corretamente definido.
    -->
    <axis xyz="0 1 0"/>

  </joint>


  <joint name="right_wheel_hinge" type="continuous">

    <parent link="chassis"/>
    <child link="right_wheel"/>

    <!-- 
      Mesma lógica aplicada à roda direita.

      A única diferença é o sinal negativo do eixo Y,
      posicionando a roda no lado oposto do robô.

      Roda esquerda:
      Y = 0.13

      Roda direita:
      Y = -0.13
    -->
    <origin xyz="0.1 -0.13 0" rpy="0 0 0"/>

    <!-- 
      A roda direita também gira em torno do eixo Y.
    -->
    <axis xyz="0 1 0"/>

  </joint>

</robot>
